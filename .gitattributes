# Auto-detect text files and normalize to LF in repo
* text=auto

# Force LF for source code and configs (important for builds)
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Shell scripts (must be LF)
*.sh text eol=lf

# Windows scripts (CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (never modify)
*.jar binary
*.war binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary